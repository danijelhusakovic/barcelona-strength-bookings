# ── Barcelona Strength — environment variables ──────────────────────────────
#
# Copy this file to .env (git-ignored) for local dev, and set these vars
# in your Vercel project settings for production / preview deployments.

# Canonical site URL — no trailing slash.
# Used by site-meta.ts for og:url, canonical, og:image, and JSON-LD.
# Production:
VITE_SITE_URL=https://barcelona-strength-bookings-dusky.vercel.app
# Once a custom domain is live, change to e.g.:
# VITE_SITE_URL=https://barcelonastrength.com
#
# Vercel sets VERCEL_ENV at build time (production | preview | development).
# vite.config.ts injects it as VITE_VERCEL_ENV for robots noindex on previews.
